   "source": [
    "### Q4. Find out the indices of non-zero element in given array[1,2,0,0,4,0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "692470a1-f93a-4dcc-a070-9c68e60f4129",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "084a687f-fcbd-410d-82a5-3cd2269b34b4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Indices of non-zero elements:\n",
      "(array([0, 1, 4]),)\n"
     ]
    }
   ],
   "source": [
    "arr = np.array([1,2,0,0,4,0])\n",
    "indices = np.nonzero(arr)\n",
    "print(\"Indices of non-zero elements:\")\n",
    "print(indices)"
   ]
  },
